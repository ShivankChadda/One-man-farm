{
  "name": "one-man-farm-video",
  "version": "1.0.0",
  "description": "The One-Man Farm — films for The Farmers of Great Nicobar (pitch cut + animated explainer), rendered with JavaScript, Playwright and ffmpeg.",
  "scripts": {
    "audio": "node scripts/audio.js",
    "render": "node scripts/render.js",
    "build": "npm run audio && npm run render",
    "stills": "node scripts/stills.js",
    "preview": "node scripts/serve.js",
    "explainer:voice": "python3 scripts/voice.py",
    "explainer:audio": "node scripts/explainer-audio.js",
    "explainer:render": "node scripts/render.js --page explainer",
    "explainer:build": "npm run explainer:voice && npm run explainer:audio && npm run explainer:render",
    "frames": "node scripts/frames.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivankChadda/One-man-farm.git"
  },
  "bugs": {
    "url": "https://github.com/ShivankChadda/One-man-farm/issues"
  },
  "homepage": "https://github.com/ShivankChadda/One-man-farm#readme",
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "playwright": "^1.56.1"
  },
  "type": "module",
  "private": true
}
